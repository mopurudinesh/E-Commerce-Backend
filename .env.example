# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce_auth?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=ecommerce_app
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-app-user-password

# JWT Security
# Generate a fresh Base64 value from 32 random bytes; keep it in your local environment only.
JWT_SECRET=replace-with-a-Base64-encoded-random-32-byte-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
